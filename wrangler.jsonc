{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kitchen-king-helper",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // API routes go to the Worker; everything else is served from ./public.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kitchen",
      // Replace with the id printed by `npx wrangler d1 create kitchen`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
